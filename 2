	local FadeProps = {
		Frame          = { "BackgroundTransparency" };
		TextLabel      = { "BackgroundTransparency", "TextTransparency", "TextStrokeTransparency" };
		TextButton     = { "BackgroundTransparency", "TextTransparency", "TextStrokeTransparency" };
		TextBox        = { "BackgroundTransparency", "TextTransparency", "TextStrokeTransparency" };
		ImageLabel     = { "BackgroundTransparency", "ImageTransparency" };
		ImageButton    = { "BackgroundTransparency", "ImageTransparency" };
		ScrollingFrame = { "BackgroundTransparency", "ScrollBarImageTransparency" };
		CanvasGroup    = { "BackgroundTransparency", "GroupTransparency" };
		UIStroke       = { "Transparency" };
	};
	local function CaptureOriginals()
		local Map = {};
		for _, Inst in Outer:GetDescendants() do
			local Props = FadeProps[Inst.ClassName];
			if Props then
				local PMap = {};
				for _, P in Props do
					local Ok, V = pcall(function() return Inst[P] end);
					if Ok then PMap[P] = V end;
				end;
				Map[Inst] = PMap;
			end;
		end;
		local OuterProps = FadeProps[Outer.ClassName];
		if OuterProps then
			local PMap = {};
			for _, P in OuterProps do
				local Ok, V = pcall(function() return Outer[P] end);
				if Ok then PMap[P] = V end;
			end;
			Map[Outer] = PMap;
		end;
		return Map;
	end;
	-- OPTIMIZED open/close: Outer stays a normal Frame (so the UI renders exactly as before).
	-- The fade is driven by ONE coroutine that writes the transparencies directly, instead of
	-- creating a TweenService tween for every descendant. With 100+ toggles the old code made
	-- 1000+ tween OBJECTS every open/close (allocation + GC + scheduling) — that was the FPS
	-- spike. Originals are re-captured on each hide, so whatever you changed while the menu was
	-- open (toggle states, the active tab) is preserved the next time it opens.
	local FADE_TIME = 0.2;
	function Window:SetVisible(State)
		State = State and true or false;
		if self.Visible == State then return end;
		self.Visible = State;
		self._FadeToken = self._FadeToken + 1;
		local Mine = self._FadeToken;
		-- If a hide interrupts a still-running fade-in, snap to the captured originals first so
		-- the snapshot below doesn't record half-faded values.
		if not State and self._FadeOriginals and os.clock() - (self._ShownAt or 0) < FADE_TIME then
			for Inst, PMap in self._FadeOriginals do
				if Inst.Parent then for P, V in PMap do Inst[P] = V end end;
			end;
		end;
		-- Re-capture the real look on every hide (and the first time), so toggle states and the
		-- active tab you changed while it was open are preserved when you reopen the menu.
		if not State or not self._FadeOriginals then
			self._FadeOriginals = CaptureOriginals();
		end;
		local Originals = self._FadeOriginals;
		if State then self._ShownAt = os.clock(); Gui.Enabled = true end;
		task.spawn(function()
			local StartT = os.clock();
			while true do
				if self._FadeToken ~= Mine then return end;      -- superseded by a newer toggle
				local A = (os.clock() - StartT) / FADE_TIME;
				if A > 1 then A = 1 end;
				local E = 1 - (1 - A) ^ 5;                        -- quint ease-out
				local Factor = State and E or (1 - E);            -- 1 = fully shown, 0 = hidden
				for Inst, PMap in Originals do
					if Inst.Parent then
						for P, V in PMap do
							Inst[P] = 1 - (1 - V) * Factor;
						end;
					end;
				end;
				if A >= 1 then break end;
				RunService.Heartbeat:Wait();
			end;
			if not State and self._FadeToken == Mine then Gui.Enabled = false end;
		end);
	end;
	function Window:Toggle()
		self:SetVisible(not self.Visible);
	end;

	function Window:Destroy()
		Gui:Destroy();
		if Library.CurrentlyOpen == self then Library.CurrentlyOpen = nil end;
	end;

	return Window;
end;

