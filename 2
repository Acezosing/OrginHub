function FakePointer()
	local A = math.random(0, 0xFFFFFF);
	local B = math.random(0, 0xFFFFFF);
	local Hex = string.format("%06x%06x", A, B);

	return setmetatable({}, {
		__tostring = function()
			return "function: 0x" .. Hex;
		end;
	});
end;

