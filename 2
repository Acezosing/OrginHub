local function BuildAvatar(Character)
    local prevArch = Character.Archivable
    Character.Archivable = true
    local ok, clone = pcall(function() return Character:Clone() end)
    Character.Archivable = prevArch
    if not ok or not clone then return nil end

    for _, d in clone:GetDescendants() do
        if d:IsA("LuaSourceContainer") or d:IsA("Sound")
            or d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then
            d:Destroy()
        elseif d:IsA("BasePart") then
            d.Anchored   = true
            d.CanCollide = false
            d.CastShadow = false      -- no shadow math in the viewport
        end
    end

    -- precompute the camera framing once (clone is frozen, so it never changes)
    local cf
    local head = clone:FindFirstChild("Head") or clone:FindFirstChild("HumanoidRootPart")
    if head and head:IsA("BasePart") then
        cf = CFrame.new(
            head.Position + head.CFrame.LookVector * 2.5 + Vector3.new(0, 0.15, 0),
            head.Position
        )
    end

    return { Model = clone, CF = cf }
end

-- reuses the existing `CurrentUserId` local (8779) as the "shown character" tracker
local function SetAvatar(Character)
    -- invalid -> just hide (keep cache intact)
    if typeof(Character) ~= "Instance" or not Character:IsA("Model") or not Character.Parent then
        if ActiveClone then ActiveClone.Parent = nil end
        ActiveClone   = nil
        CurrentUserId = nil
        return
    end

    if Character == CurrentUserId then return end   -- same target already shown
    CurrentUserId = Character

    if ActiveClone then ActiveClone.Parent = nil end  -- hide current (stays alive in cache)

    local entry = AvatarCache[Character]
    if not entry then                                 -- cache miss -> build once
        entry = BuildAvatar(Character)
        if not entry then ActiveClone = nil; return end
        AvatarCache[Character] = entry
    end

    TouchLRU(Character)
    EvictIfNeeded()

    entry.Model.Parent = AvatarViewport
    ActiveClone = entry.Model
    if entry.CF then AvatarCamera.CFrame = entry.CF end
end

local function SetName(Name)
		NameLbl.Text = tostring(Name or "Player");
		if ModBadge.Visible then
			ModBadge.Position = UDim2.new(0, NameLbl.AbsoluteSize.X + 6, 0.5, 0);
		end;
	end;
	local function SetHealth(Current, Max)
		Current = tonumber(Current) or 0;
		Max = tonumber(Max) or 100;
		if Max <= 0 then Max = 1; end;

		local Pct = math.clamp(Current / Max, 0, 1);
		local Color = Library.Accent;

		local BarInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out);
		Library:Tween(HealthFill, BarInfo, {
			Size = UDim2.new(Pct, -2, 1, -2);
			BackgroundColor3 = Color;
		}):Play();

		HealthCounterToken = HealthCounterToken + 1;
		local Mine = HealthCounterToken;

		local StartCurrent = tonumber(string.match(HealthText.Text, "^(%-?%d+%.?%d*)")) or Current;
		local StartMax = tonumber(string.match(HealthText.Text, "/%s*(%-?%d+%.?%d*)")) or Max;

		local Duration = 0.25;
		local StartTime = os.clock();

		task.spawn(function()
			while true do
				if HealthCounterToken ~= Mine then return; end;

				local Elapsed = os.clock() - StartTime;
				local Alpha = math.clamp(Elapsed / Duration, 0, 1);
				local Eased = 1 - (1 - Alpha) ^ 3;

				local DisplayCurrent = StartCurrent + (Current - StartCurrent) * Eased;
				local DisplayMax = StartMax + (Max - StartMax) * Eased;

				HealthText.Text = string.format("%d / %d", math.floor(DisplayCurrent + 0.5), math.floor(DisplayMax + 0.5));

				if Alpha >= 1 then break; end;
				task.wait();
			end;

			if HealthCounterToken == Mine then
				HealthText.Text = string.format("%d / %d", math.floor(Current + 0.5), math.floor(Max + 0.5));
			end;
		end);

		LastHealthPct = Pct;
	end;

	local function SetKDR(Text)
		KdrLbl.Text = "KDR: " .. tostring(Text or "");
	end;

	local function SetPlayTime(Text)
