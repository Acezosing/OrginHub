								CancelListen();
							else
								Key = K;
								Listening = false;
								if ListenConn then ListenConn:Disconnect(); ListenConn = nil end;
								Refresh();
								Library:NotifyKeybind();
							end;
						elseif T == Enum.UserInputType.MouseButton1
							or T == Enum.UserInputType.MouseButton2
							or T == Enum.UserInputType.MouseButton3 then
							Key = T;
							Listening = false;
							if ListenConn then ListenConn:Disconnect(); ListenConn = nil end;
