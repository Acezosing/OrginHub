        if not e.Bg or not e.Bg.Parent then
            list[i] = list[#list]
            list[#list] = nil
            continue
        end
        -- settle check
        if math.abs(e.Target - e.T) < 0.001 then
            if e.T ~= e.Target then
                e.T = e.Target
                e.Apply(e.T)
            end
            i += 1
            continue
        end
        e.T = e.T + (e.Target - e.T) * (1 - math.exp(-Dt * 16))
        e.Apply(e.T)
        i += 1
    end
end)

