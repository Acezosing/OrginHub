		VisibleLbl.Text = IsVisible and "Visible" or "Not Visible";
		Library:Tween(VisibleLbl, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			TextColor3 = Target;
		}):Play();
	end;

